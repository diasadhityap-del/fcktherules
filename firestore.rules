rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ADMIN WHITELIST (2 email)
    // Email ini HARUS terdaftar di Firebase Console -> Authentication -> Users
    // ============================================================
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'diasadhityap@gmail.com',
          'fvcktherules3404@gmail.com'
        ];
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ============================================================
    // PUBLIK: read semua orang, write HANYA admin
    // ============================================================
    match /produk/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galeri/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // VOUCHERS
    // - Publik boleh read (cek kode) dan HANYA boleh menurunkan kuota
    //   (potong kuota saat checkout). Field lain tidak bisa diubah publik.
    // - Admin: create, update, delete
    // ============================================================
    match /vouchers/{document=**} {
      allow read: if true;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kuota'])
            && request.resource.data.kuota is number
            && request.resource.data.kuota >= 0
            && request.resource.data.kuota <= resource.data.kuota);
      allow create, delete: if isAdmin();
    }

    // ============================================================
    // ORDERS
    // - Publik bisa CREATE (guest checkout), status awal wajib 'pending'
    // - Read: admin (semua) ATAU customer pemilik order
    // - Update/Delete: hanya admin
    // ============================================================
    match /orders/{document=**} {
      allow create: if request.resource.data.status == 'pending';
      allow read:   if isAdmin()
                    || (isLoggedIn() && (
                         resource.data.customerUid == request.auth.uid
                         || resource.data.email == request.auth.token.email
                       ));
      // ID Pemesanan (kodePelunasan) permanen: boleh diisi sekali (backfill order lama), tidak boleh diubah
      allow update: if isAdmin()
                    && (!('kodePelunasan' in resource.data)
                        || request.resource.data.kodePelunasan == resource.data.kodePelunasan);
      allow delete: if isAdmin();
    }

    // ============================================================
    // PELUNASAN (doc ID = kode pelunasan milik customer, mis. SLMN-7K2QX)
    // - get: publik, tapi hanya kalau tahu kode persis (tidak bisa list/menebak daftar)
    // - list/create/delete: admin
    // - update: admin, ATAU customer hanya untuk mengirim bukti pelunasan
    // ============================================================
    match /pelunasan/{kode} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.status in ['dp', 'menunggu_verifikasi']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['buktiPelunasanURL', 'buktiPelunasanAt', 'status'])
            && request.resource.data.status == 'menunggu_verifikasi'
            && request.resource.data.buktiPelunasanURL is string);
    }

    // ============================================================
    // PANTAU PESANAN (PRE ORDER)
    // - lacak/{kode}: get publik (harus tahu ID persis). Create oleh pembeli saat checkout
    //   (pay wajib 'pending'). Update/hapus/list hanya admin.
    // - lacakIdx/{hash}: indeks no HP / email (SHA-256). get publik; pembeli hanya boleh
    //   membuat atau MENAMBAH tepat 1 ID. Tidak ada list.
    // - poTrack/{produkId}: status per artikel PO. get publik, tulis hanya admin.
    // ============================================================
    match /lacak/{kode} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.resource.data.pay == 'pending'
                    && request.resource.data.kode == kode;
    }
    // Timeline per order: lacak/{kode}/timeline/{id}
    // - baca publik (path memuat ID order, lacak tidak bisa di-list)
    // - "Pesanan dibuat" (id 'created') dibuat sekali oleh sistem saat checkout, waktu = waktu server
    // - admin: tambah update manual; hanya update manual yang boleh diubah/dihapus (event otomatis permanen)
    match /lacak/{kode}/timeline/{eid} {
      allow get, list: if true;
      allow create: if isAdmin()
        || (eid == 'created'
            && request.resource.data.type == 'automatic'
            && request.resource.data.kind == 'created'
            && request.resource.data.text == 'Pesanan dibuat'
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/lacak/$(kode)));
      allow update, delete: if isAdmin() && resource.data.type == 'manual';
    }
    match /lacakIdx/{h} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['kodes'])
                    && request.resource.data.kodes is list
                    && request.resource.data.kodes.size() == 1;
      allow update: if isAdmin()
        || (request.resource.data.keys().hasOnly(['kodes'])
            && request.resource.data.kodes.size() == resource.data.kodes.size() + 1
            && request.resource.data.kodes.size() <= 100
            && request.resource.data.kodes.hasAll(resource.data.kodes));
    }
    match /poTrack/{produkId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ============================================================
    // CUSTOMERS
    // - Customer hanya bisa akses datanya sendiri (doc ID = uid)
    // - Admin bisa read & delete semua
    // ============================================================
    match /customers/{customerId} {
      allow create: if isLoggedIn() && request.auth.uid == customerId;
      allow read:   if isAdmin()
                    || (isLoggedIn() && request.auth.uid == customerId);
      allow update: if isLoggedIn() && request.auth.uid == customerId;
      allow delete: if isAdmin();
    }
  }
}
